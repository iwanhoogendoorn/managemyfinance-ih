# BRAT and Obsidian both fetch a plugin's assets from releases/download/<manifest.json version>/,
# so the git tag has to equal the version exactly — "0.2.0", never "v0.2.0". npm tags with a "v"
# prefix by default, which release.yml is built to reject; this makes `npm version` produce the
# tag the workflow actually wants.
tag-version-prefix=""
